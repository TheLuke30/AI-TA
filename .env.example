# Copy this file to .env and fill in real values. .env is gitignored; this file is the template.
# Each variable is read by the service that needs it. Blank = fill in.

# --- LLM provider (Step 2+). "openai" now, "bedrock" after Step 10b ---
LLM_PROVIDER=openai
OPENAI_API_KEY=

# --- Pinecone vector DB (Step 2) ---
PINECONE_API_KEY=
PINECONE_INDEX=ai-ta

# --- MongoDB (Step 4) — local Docker container, no account needed ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_ta

# --- Neo4j (Step 5) — local Docker container, no account needed ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- LiveKit (Step 11) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- AWS (Step 10) — the CLI uses ~/.aws; this is only for services that need a region ---
AWS_REGION=us-east-1
